+//! Прямые варианты без поиска: прямая линия и «Z».
+
+use super::cost::{BEND_W, LEN_W, NONNATURAL, TIE_DIV};
+use super::model::{Pt, Side, Terminal, U};
+use super::obstacles::{h_free, v_free, Obstacle, Own};
+use super::stubs::columns;
+
+/// Допуск «порты на одной высоте» (субклетки).
+pub const SAME_Y: i32 = 2;
+
+/// Кандидат маршрута: стороны, точки, упакованная стоимость и длина.
+#[derive(Clone, Debug, PartialEq, Eq)]
+pub struct Candidate {
+    /// Сторона источника.
+    pub src_side: Side,
+    /// Сторона цели.
+    pub dst_side: Side,
+    /// Точки маршрута (субклетки).
+    pub points: Vec<Pt>,
+    /// Упакованная стоимость.
+    pub cost: u64,
+    /// Длина (субклетки).
+    pub len: i64,
+}
+
+/// Середина между карточками (субклетки) по естественной паре портов:
+/// целое деление с отсечением к нулю.
+pub fn mid(src: &Terminal, dst: &Terminal) -> (i32, i32) {
+    let (a, b) = (src.right, dst.left);
+    ((a.x + b.x) / 2, (a.y + b.y) / 2)
+}
+
+/// Лучший прямой вариант среди четырёх пар сторон. При равной цене побеждает найденный первым.
+pub fn best(obs: &[Obstacle], src: &Terminal, dst: &Terminal, min_stub: i32) -> Option<Candidate> {
+    let (xmid, _) = mid(src, dst);
+    let mut best: Option<Candidate> = None;
+    for s in Side::BOTH {
+        for t in Side::BOTH {
+            let (ps, pt) = (src.port(s), dst.port(t));
+            let dy = (pt.y - ps.y).abs();
+            let nonnat = if s == Side::Right && t == Side::Left { 0 } else { NONNATURAL };
+            if dy <= SAME_Y {
+                let facing = (s == Side::Right && t == Side::Left && pt.x > ps.x)
+                    || (s == Side::Left && t == Side::Right && pt.x < ps.x);
+                if !facing {
+                    continue;
+                }
+                let len = (pt.x - ps.x).abs();
+                if len < 2 * U || !h_free(obs, ps.y, ps.x, pt.x, &[Own::Src, Own::Dst]) {
+                    continue;
+                }
+                let cost = len as u64 * LEN_W + nonnat;
+                consider(&mut best, Candidate { src_side: s, dst_side: t, points: vec![ps, pt], cost, len: len as i64 });
+            } else {
+                let Some(cs) = columns(obs, Own::Src, src.edge_x(s), s, ps.y, min_stub, None) else { continue };
+                let Some(ct) = columns(obs, Own::Dst, dst.edge_x(t), t, pt.y, min_stub, None) else { continue };
+                let (lo, hi) = (cs.0.max(ct.0), cs.1.min(ct.1));
+                for v in lo..=hi {
+                    if !v_free(obs, v, ps.y, pt.y) {
+                        continue;
+                    }
+                    let vx = v * U;
+                    let len = (vx - ps.x).abs() + dy + (vx - pt.x).abs();
+                    let beauty = ((vx - xmid).abs() / TIE_DIV) as u64 * ((dy / U).max(1) as u64);
+                    let cost = len as u64 * LEN_W + 2 * BEND_W + nonnat + beauty;
+                    consider(
+                        &mut best,
+                        Candidate {
+                            src_side: s,
+                            dst_side: t,
+                            points: vec![ps, Pt::new(vx, ps.y), Pt::new(vx, pt.y), pt],
+                            cost,
+                            len: len as i64,
+                        },
+                    );
+                }
+            }
+        }
+    }
+    best
+}
+
+fn consider(best: &mut Option<Candidate>, c: Candidate) {
+    if best.as_ref().map_or(true, |b| c.cost < b.cost) {
+        *best = Some(c);
+    }
+}
diff -ruN -x target -x Cargo.lock a/crates/canvas/src/routing/layer.rs b/crates/canvas/src/routing/layer.rs
--- a/crates/canvas/src/routing/layer.rs	1970-01-01 00:00:00.000000000 +0000
+++ b/crates/canvas/src/routing/layer.rs	2026-11-25 09:17:27.000000000 +0000
@@ -0,0 +1,257 @@
+//! Слой линий: кэш маршрутов и ленивый пересчёт.
+//!
+//! Маршрутизатор — чистая функция; всё, что связано с хранением результатов, живёт здесь.
+//! Слой не хранится в документе и не передаётся наружу.
+
+use std::collections::hash_map::DefaultHasher;
+use std::collections::HashMap;
+use std::hash::{Hash, Hasher};
+
+use polygram_core::geometry::{EdgeGeom, ObjectGeom};
+use polygram_core::layout::Rect;
+use polygram_core::types::{Direction, NodeKind};
+
+use super::model::{round_away, union_rect, Pt, Route, Side, Terminal, U};
+use super::{ports, router};
+
+/// Карточка Процесса, участвующая в маршрутизации.
+#[derive(Clone, Debug)]
+pub struct CardInfo {
+    /// Идентификатор объекта.
+    pub id: String,
+    /// Занимаемый прямоугольник в клетках (округлён наружу по реальному размеру карточки).
+    pub rect: Rect,
+    /// Число строк в контейнере «Запрос».
+    pub n_req: usize,
+    /// Число строк в контейнере «Результат».
+    pub n_res: usize,
+}
+
+/// Положение показателя: карточка, контейнер, номер строки.
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub struct EntryRef {
+    /// Индекс карточки в списке слоя.
+    pub card: usize,
+    /// Контейнер.
+    pub dir: Direction,
+    /// Номер строки с нуля.
+    pub row: usize,
+}
+
+/// Связь между двумя показателями.
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub struct EdgeRef {
+    /// Ключ связи.
+    pub ix: u32,
+    /// Ключ показателя-источника (строка «Результат»).
+    pub from: u32,
+    /// Ключ показателя-цели (строка «Запрос»).
+    pub to: u32,
+}
+
+struct Cached {
+    route: Route,
+    key: u64,
+    checked: u64,
+}
+
+/// Кэш маршрутов и описание карточек/показателей для текущей геометрии.
+#[derive(Default)]
+pub struct EdgeLayer {
+    fingerprint: Option<u64>,
+    cell_size: f32,
+    generation: u64,
+    cards: Vec<CardInfo>,
+    entries: HashMap<u32, EntryRef>,
+    edges: Vec<EdgeRef>,
+    routes: HashMap<u32, Cached>,
+    /// Сколько раз запускался маршрутизатор (для тестов и отладки).
+    pub route_calls: u64,
+}
+
+fn kind_tag(k: NodeKind) -> u8 {
+    match k {
+        NodeKind::Process => 0,
+        NodeKind::Department => 1,
+        NodeKind::Container => 2,
+        NodeKind::Metric => 3,
+        #[allow(unreachable_patterns)]
+        _ => 255,
+    }
+}
+
+fn hash_rect(h: &mut DefaultHasher, r: &Rect) {
+    r.x.hash(h);
+    r.y.hash(h);
+    r.w.hash(h);
+    r.h.hash(h);
+}
+
+fn hash_pt(h: &mut DefaultHasher, p: &Pt) {
+    p.hash(h);
+}
+
+impl EdgeLayer {
+    /// Создать пустой слой.
+    pub fn new() -> Self {
+        Self::default()
+    }
+
+    /// Рёбра текущего снимка.
+    pub fn edges(&self) -> &[EdgeRef] {
+        &self.edges
+    }
+
+    /// Карточка по индексу.
+    pub fn card(&self, i: usize) -> &CardInfo {
+        &self.cards[i]
+    }
+
+    /// Положение показателя по ключу.
+    pub fn entry(&self, ix: u32) -> Option<&EntryRef> {
+        self.entries.get(&ix)
+    }
+
+    /// Поколение геометрии (растёт при любом изменении карточек и связей).
+    pub fn generation(&self) -> u64 {
+        self.generation
+    }
+
+    /// Смещение порта показателя от левого верхнего угла карточки (пиксели, масштаб 1).
+    pub fn port_offset_px(&self, e: &EntryRef, side: Side) -> (f32, f32) {
+        ports::row_port_px(self.cards[e.card].n_req, e.dir, e.row, side)
+    }
+
+    /// Рамка обеих карточек связи (клетки); нужна для отсечения невидимых линий.
+    pub fn pair_frame(&self, edge: &EdgeRef) -> Option<Rect> {
+        let a = self.entries.get(&edge.from)?;
+        let b = self.entries.get(&edge.to)?;
+        Some(union_rect(&self.cards[a.card].rect, &self.cards[b.card].rect))
+    }
+
+    /// Синхронизация со снимком геометрии. Вызывается перед отрисовкой линий.
+    /// Если снимок не изменился — ничего не делает.
+    pub fn sync(&mut self, objects: &[ObjectGeom], edges: &[EdgeGeom], cell_size: f32) {
+        let fp = Self::fingerprint_of(objects, edges, cell_size);
+        if self.fingerprint == Some(fp) {
+            return;
+        }
+        if self.cell_size.to_bits() != cell_size.to_bits() {
+            // Порты считаются из пикселей, поэтому смена размера клетки меняет всё.
+            self.routes.clear();
+        }
+        self.cell_size = cell_size;
+        self.fingerprint = Some(fp);
+        self.generation += 1;
+
+        self.cards.clear();
+        self.entries.clear();
+        for o in objects.iter().filter(|o| o.kind == NodeKind::Process) {
+            let (w_px, h_px) = ports::card_size_px(o.requests.len(), o.results.len());
+            // Округление наружу: линии не должны заходить на дробную часть карточки.
+            let w = (w_px / cell_size).ceil() as i32;
+            let h = (h_px / cell_size).ceil() as i32;
+            let card = self.cards.len();
+            self.cards.push(CardInfo {
+                id: o.id.clone(),
+                rect: Rect::new(o.rect.x, o.rect.y, w, h),
+                n_req: o.requests.len(),
+                n_res: o.results.len(),
+            });
+            for (row, e) in o.requests.iter().enumerate() {
+                self.entries.insert(e.ix, EntryRef { card, dir: Direction::Request, row });
+            }
+            for (row, e) in o.results.iter().enumerate() {
+                self.entries.insert(e.ix, EntryRef { card, dir: Direction::Result, row });
+            }
+        }
+        self.edges = edges.iter().map(|e| EdgeRef { ix: e.ix, from: e.from, to: e.to }).collect();
+        let alive: std::collections::HashSet<u32> = self.edges.iter().map(|e| e.ix).collect();
+        self.routes.retain(|k, _| alive.contains(k));
+    }
+
+    fn fingerprint_of(objects: &[ObjectGeom], edges: &[EdgeGeom], cell_size: f32) -> u64 {
+        let mut h = DefaultHasher::new();
+        cell_size.to_bits().hash(&mut h);
+        for o in objects {
+            o.ix.hash(&mut h);
+            kind_tag(o.kind).hash(&mut h);
+            hash_rect(&mut h, &o.rect);
+            o.requests.len().hash(&mut h);
+            for e in &o.requests {
+                e.ix.hash(&mut h);
+            }
+            u8::MAX.hash(&mut h);
+            for e in &o.results {
+                e.ix.hash(&mut h);
+            }
+            u8::MAX.hash(&mut h);
+        }
+        for e in edges {
+            (e.ix, e.from, e.to).hash(&mut h);
+        }
+        h.finish()
+    }
+
+    /// Терминал для показателя: прямоугольник карточки и оба порта строки (субклетки).
+    pub fn terminal(&self, e: &EntryRef) -> Terminal {
+        let card = &self.cards[e.card];
+        let sub = |px: f32| round_away(px * U as f32 / self.cell_size);
+        let port = |side: Side| {
+            let (ox, oy) = ports::row_port_px(card.n_req, e.dir, e.row, side);
+            Pt::new(card.rect.x * U + sub(ox), card.rect.y * U + sub(oy))
+        };
+        Terminal { card: e.card as u32, rect: card.rect, left: port(Side::Left), right: port(Side::Right) }
+    }
+
+    /// Отпечаток маршрута: оба терминала и все карточки, строго пересекающие область влияния.
+    fn route_key(&self, src: &Terminal, dst: &Terminal, region: &Rect) -> u64 {
+        let mut h = DefaultHasher::new();
+        for t in [src, dst] {
+            t.card.hash(&mut h);
+            hash_rect(&mut h, &t.rect);
+            hash_pt(&mut h, &t.left);
+            hash_pt(&mut h, &t.right);
+        }
+        for (i, c) in self.cards.iter().enumerate() {
+            if region.overlaps(&c.rect) {
+                i.hash(&mut h);
+                hash_rect(&mut h, &c.rect);
+            }
+        }
+        h.finish()
+    }
+
+    /// Маршрут связи. `None`, если связь не пригодна для линии (ключ источника не в «Результате»
+    /// или ключ цели не в «Запросе»). Пересчитывается лениво и только если изменились
+    /// терминалы или карточки в области влияния.
+    pub fn route(&mut self, edge: &EdgeRef) -> Option<Route> {
+        let src_e = *self.entries.get(&edge.from)?;
+        let dst_e = *self.entries.get(&edge.to)?;
+        if src_e.dir != Direction::Result || dst_e.dir != Direction::Request {
+            return None;
+        }
+        if let Some(c) = self.routes.get(&edge.ix) {
+            if c.checked == self.generation {
+                return Some(c.route.clone());
+            }
+        }
+        let src = self.terminal(&src_e);
+        let dst = self.terminal(&dst_e);
+        if let Some((region, key)) = self.routes.get(&edge.ix).map(|c| (c.route.region, c.key)) {
+            if self.route_key(&src, &dst, &region) == key {
+                let gen = self.generation;
+                let c = self.routes.get_mut(&edge.ix)?;
+                c.checked = gen;
+                return Some(c.route.clone());
+            }
+        }
+        let cards: Vec<(u32, Rect)> =
+            self.cards.iter().enumerate().map(|(i, c)| (i as u32, c.rect)).collect();
+        self.route_calls += 1;
+        let route = router::route(&cards, &src, &dst);
+        let key = self.route_key(&src, &dst, &route.region);
+        self.routes.insert(edge.ix, Cached { route: route.clone(), key, checked: self.generation });
+        Some(route)
+    }
+}
diff -ruN -x target -x Cargo.lock a/crates/canvas/src/routing/layer_tests.rs b/crates/canvas/src/routing/layer_tests.rs
--- a/crates/canvas/src/routing/layer_tests.rs	1970-01-01 00:00:00.000000000 +0000
+++ b/crates/canvas/src/routing/layer_tests.rs	2026-11-25 09:26:18.000000000 +0000
@@ -0,0 +1,253 @@
+//! Тесты слоя: кэш, ленивый пересчёт, терминалы, перевод в экран, цвет и скругление.
+
+use egui::{Pos2, Vec2};
+use polygram_core::geometry::{EdgeGeom, EntryGeom, ObjectGeom};
+use polygram_core::layout::Rect;
+use polygram_core::types::{Direction, MetricValue, NodeKind, StatusCode};
+use polygram_core::DynamicState;
+
+use super::layer::{EdgeLayer, EdgeRef};
+use super::model::{Quality, Side, U};
+use super::ports;
+use super::screen::route_to_screen;
+use crate::paint::edge::{edge_color, rounded_points};
+use crate::paint::object::process_total_height;
+use crate::Theme;
+
+fn entry(ix: u32) -> EntryGeom {
+    EntryGeom {
+        ix,
+        name: format!("m{ix}"),
+        value: MetricValue::Null,
+        supplied: MetricValue::Null,
+        unit: String::new(),
+    }
+}
+
+/// Процесс: запросы получают ключи `base..base+n_req`, результаты — следующие `n_res`.
+fn process(ix: u32, x: i32, y: i32, n_req: u32, n_res: u32, base: u32) -> ObjectGeom {
+    ObjectGeom {
+        ix,
+        id: format!("p{ix}"),
+        name: format!("Процесс {ix}"),
+        kind: NodeKind::Process,
+        rect: Rect::new(x, y, 32, 17),
+        direction: None,
+        requests: (0..n_req).map(|i| entry(base + i)).collect(),
+        results: (0..n_res).map(|i| entry(base + n_req + i)).collect(),
+        parent: None,
+    }
+}
+
+fn department(ix: u32, rect: Rect) -> ObjectGeom {
+    ObjectGeom {
+        ix,
+        id: format!("d{ix}"),
+        name: "Отдел".into(),
+        kind: NodeKind::Department,
+        rect,
+        direction: None,
+        requests: vec![],
+        results: vec![],
+        parent: None,
+    }
+}
+
+/// Два процесса: источник (ключи 0..4, результат — ключ 2), цель (ключи 10..14, запрос — ключ 10).
+fn scene(dst_x: i32, dst_y: i32) -> (Vec<ObjectGeom>, Vec<EdgeGeom>) {
+    let a = process(0, 0, 0, 2, 2, 0);
+    let b = process(1, dst_x, dst_y, 2, 2, 10);
+    (vec![a, b], vec![EdgeGeom { ix: 0, from: 2, to: 10 }])
+}
+
+fn first_edge(l: &EdgeLayer) -> EdgeRef {
+    l.edges()[0]
+}
+
+#[test]
+fn card_height_matches_painter() {
+    let dynamic = DynamicState::default();
+    for (nq, nr) in [(0usize, 0usize), (1, 0), (0, 3), (2, 2), (4, 7)] {
+        let o = process(0, 0, 0, nq as u32, nr as u32, 0);
+        let painted = process_total_height(&o, &dynamic, 1.0, 512.0);
+        let (w, h) = ports::card_size_px(nq, nr);
+        assert!((painted - h).abs() < 1e-3, "{nq}/{nr}: {painted} vs {h}");
+        assert_eq!(w, 512.0);
+    }
+}
+
+#[test]
+fn ports_sit_on_row_edges_at_row_centers() {
+    // Запрос 0: контейнер начинается на 80, строка — на 80+8+48 = 136, центр 152.
+    assert_eq!(ports::row_port_px(2, Direction::Request, 0, Side::Left), (16.0, 152.0));
+    assert_eq!(ports::row_port_px(2, Direction::Request, 1, Side::Right), (496.0, 192.0));
+    // Результат при двух запросах: 80 + (56+80) + 8 = 224; центр строки 0 = 224+8+48+16 = 296.
+    assert_eq!(ports::row_port_px(2, Direction::Result, 0, Side::Left), (16.0, 296.0));
+}
+
+#[test]
+fn route_is_cached_until_geometry_changes() {
+    let (objs, edges) = scene(40, 6);
+    let mut l = EdgeLayer::new();
+    l.sync(&objs, &edges, 16.0);
+    let e = first_edge(&l);
+    let r1 = l.route(&e).expect("маршрут");
+    assert_eq!(l.route_calls, 1);
+    assert_eq!(r1.quality, Quality::Clean);
+
+    // Тот же снимок — ничего не пересчитывается.
+    l.sync(&objs, &edges, 16.0);
+    let r2 = l.route(&e).unwrap();
+    assert_eq!(r1, r2);
+    assert_eq!(l.route_calls, 1);
+
+    // Сдвиг карточки цели по Y меняет маршрут.
+    let (objs2, edges2) = scene(40, 18);
+    l.sync(&objs2, &edges2, 16.0);
+    let r3 = l.route(&e).unwrap();
+    assert_eq!(l.route_calls, 2);
+    assert_ne!(r1.points, r3.points);
+}
+
+#[test]
+fn far_card_does_not_recompute_but_own_card_does() {
+    let (mut objs, edges) = scene(40, 6);
+    objs.push(process(2, 900, 900, 1, 1, 20));
+    let mut l = EdgeLayer::new();
+    l.sync(&objs, &edges, 16.0);
+    let e = first_edge(&l);
+    l.route(&e).unwrap();
+    assert_eq!(l.route_calls, 1);
+
+    // Далёкая карточка сдвинулась — пересчёта нет.
+    objs[2].rect.x += 7;
+    l.sync(&objs, &edges, 16.0);
+    l.route(&e).unwrap();
+    assert_eq!(l.route_calls, 1);
+
+    // Сдвинулась карточка самой связи — ровно один пересчёт.
+    objs[0].rect.y += 7;
+    l.sync(&objs, &edges, 16.0);
+    l.route(&e).unwrap();
+    assert_eq!(l.route_calls, 2);
+}
+
+#[test]
+fn huge_department_frame_is_not_an_obstacle() {
+    let (mut objs, edges) = scene(40, 6);
+    objs.insert(0, department(9, Rect::new(-5, -5, 2000, 2000)));
+    let mut l = EdgeLayer::new();
+    l.sync(&objs, &edges, 16.0);
+    let r = l.route(&first_edge(&l)).unwrap();
+    assert_eq!(r.quality, Quality::Clean);
+}
+
+#[test]
+fn invalid_edges_have_no_route() {
+    let (objs, _) = scene(40, 6);
+    let mut l = EdgeLayer::new();
+    // Источник — запрос (ключ 0), цель — результат (ключ 2): направление неверное.
+    l.sync(&objs, &[EdgeGeom { ix: 0, from: 0, to: 2 }], 16.0);
+    assert!(l.route(&first_edge(&l)).is_none());
+    // Несуществующие ключи.
+    l.sync(&objs, &[EdgeGeom { ix: 1, from: 77, to: 78 }], 16.0);
+    assert!(l.route(&first_edge(&l)).is_none());
+}
+
+#[test]
+fn cell_size_change_clears_cache() {
+    let (objs, edges) = scene(40, 6);
+    let mut l = EdgeLayer::new();
+    l.sync(&objs, &edges, 16.0);
+    let e = first_edge(&l);
+    l.route(&e).unwrap();
+    l.sync(&objs, &edges, 20.0);
+    l.route(&e).unwrap();
+    assert_eq!(l.route_calls, 2);
+}
+
+#[test]
+fn obstacle_card_between_forces_detour_without_crossing() {
+    // Между источником (0..32) и целью (80..) стоит карточка (40..72) на той же высоте.
+    let mut objs = vec![process(0, 0, 0, 2, 2, 0), process(1, 80, 0, 2, 2, 10), process(2, 40, 0, 1, 1, 20)];
+    objs[2].rect = Rect::new(40, 0, 32, 17);
+    let edges = vec![EdgeGeom { ix: 0, from: 2, to: 10 }];
+    let mut l = EdgeLayer::new();
+    l.sync(&objs, &edges, 16.0);
+    let r = l.route(&first_edge(&l)).unwrap();
+    assert_eq!(r.quality, Quality::Clean);
+    let wall = l.card(2).rect;
+    for w in r.points.windows(2).skip(1).take(r.points.len().saturating_sub(3)) {
+        let (a, b) = (w[0], w[1]);
+        if a.y == b.y {
+            let inside_y = wall.y * U < a.y && a.y < (wall.y + wall.h) * U;
+            let overlap_x = a.x.min(b.x) < (wall.x + wall.w) * U && wall.x * U < a.x.max(b.x);
+            assert!(!(inside_y && overlap_x));
+        }
+    }
+}
+
+#[test]
+fn screen_route_is_orthogonal_at_any_zoom() {
+    let (objs, edges) = scene(40, 6);
+    let mut l = EdgeLayer::new();
+    l.sync(&objs, &edges, 16.0);
+    let e = first_edge(&l);
+    let route = l.route(&e).unwrap();
+    let (src_e, dst_e) = (*l.entry(e.from).unwrap(), *l.entry(e.to).unwrap());
+    for zoom in [0.4f32, 0.75, 1.0, 1.7] {
+        for shift in [Vec2::ZERO, Vec2::new(5.3, -7.1)] {
+            let offset = (30.0f32, 12.0f32);
+            let port = |entry: &super::layer::EntryRef, side: Side, drag: Vec2| {
+                let card = l.card(entry.card);
+                let origin = Pos2::new(
+                    (card.rect.x as f32 * 16.0 + offset.0) * zoom,
+                    (card.rect.y as f32 * 16.0 + offset.1) * zoom,
+                );
+                let (ox, oy) = l.port_offset_px(entry, side);
+                origin + drag + Vec2::new(ox, oy) * zoom
+            };
+            let sp = port(&src_e, route.src_side, shift);
+            let dp = port(&dst_e, route.dst_side, Vec2::ZERO);
+            let pts = route_to_screen(&route.points, 16.0, offset, zoom, sp, dp);
+            assert_eq!(pts[0], sp);
+            assert_eq!(*pts.last().unwrap(), dp);
+            for w in pts.windows(2) {
+                assert!((w[0].x - w[1].x).abs() < 1e-3 || (w[0].y - w[1].y).abs() < 1e-3, "диагональ при zoom {zoom}");
+            }
+            let n = pts.len();
+            assert!((pts[0].y - pts[1].y).abs() < 1e-3);
+            assert!((pts[n - 1].y - pts[n - 2].y).abs() < 1e-3);
+        }
+    }
+}
+
+#[test]
+fn edge_color_follows_statuses() {
+    let t = Theme::dark();
+    assert_eq!(edge_color(&t, StatusCode::Ok, StatusCode::Ok), t.status_ok);
+    assert_eq!(edge_color(&t, StatusCode::Surplus, StatusCode::Ok), t.status_ok);
+    assert_eq!(edge_color(&t, StatusCode::InProgress, StatusCode::Ok), t.status_deficit);
+    assert_eq!(edge_color(&t, StatusCode::Expected, StatusCode::Ok), t.status_deficit);
+    assert_eq!(edge_color(&t, StatusCode::Ok, StatusCode::Expected), t.status_deficit);
+    assert_eq!(edge_color(&t, StatusCode::Ok, StatusCode::Surplus), t.status_ok);
+}
+
+#[test]
+fn rounded_corner_is_tangent_arc() {
+    let pts = [Pos2::new(0.0, 0.0), Pos2::new(100.0, 0.0), Pos2::new(100.0, 80.0)];
+    assert_eq!(rounded_points(&pts, 0.0), pts.to_vec());
+    let r = 10.0;
+    let out = rounded_points(&pts, r);
+    assert_eq!(out[0], pts[0]);
+    assert_eq!(*out.last().unwrap(), pts[2]);
+    // Дуга начинается на r до угла и заканчивается на r после него, центр — (90, 10).
+    assert!((out[1] - Pos2::new(90.0, 0.0)).length() < 1e-3);
+    assert!((out[out.len() - 2] - Pos2::new(100.0, 10.0)).length() < 1e-3);
+    for p in &out[1..out.len() - 1] {
+        assert!(((*p - Pos2::new(90.0, 10.0)).length() - r).abs() < 1e-3);
+    }
+    // Радиус ограничен половиной самого короткого отрезка (80 / 2 = 40 → 1000 урезается до 40).
+    let big = rounded_points(&pts, 1000.0);
+    assert!((big[1] - Pos2::new(60.0, 0.0)).length() < 1e-3);
+}
