+//! Ортогональные линии связи между показателями (ТЗ «Ортогональные линии связи»).
+//!
+//! Модуль разделён на чистое ядро без зависимости от egui и тонкий слой отрисовки:
+//! - `model`     — единицы, стороны, терминалы, маршрут, упрощение точек;
+//! - `cost`      — веса стоимости (длина → колена → красота);
+//! - `obstacles` — препятствия и проверки свободы отрезков;
+//! - `stubs`     — допустимые колонки первого и последнего отрезков;
+//! - `direct`    — прямая и «Z» без поиска;
+//! - `search`    — A* по сжатой сетке;
+//! - `router`    — ступени качества, область влияния, запасная ломаная;
+//! - `ports`     — геометрия строк Процесса и точки сцепления;
+//! - `layer`     — кэш маршрутов и ленивый пересчёт;
+//! - `screen`    — перевод маршрута в экранные координаты.
+//!
+//! Линии нигде не сериализуются: они строятся из положения карточек.
+
+pub mod cost;
+pub mod direct;
+pub mod layer;
+pub mod model;
+pub mod obstacles;
+pub mod ports;
+pub mod router;
+pub mod screen;
+pub mod search;
+pub mod stubs;
+
+#[cfg(test)]
+mod layer_tests;
+#[cfg(test)]
+mod tests;
+
+pub use layer::{CardInfo, EdgeLayer, EdgeRef, EntryRef};
+pub use model::{Pt, Quality, Route, Side, Terminal, U};
+pub use router::route;
diff -ruN -x target -x Cargo.lock a/crates/canvas/src/routing/model.rs b/crates/canvas/src/routing/model.rs
--- a/crates/canvas/src/routing/model.rs	1970-01-01 00:00:00.000000000 +0000
+++ b/crates/canvas/src/routing/model.rs	2026-11-25 09:15:01.000000000 +0000
@@ -0,0 +1,162 @@
+//! Единицы, стороны, терминалы и маршрут.
+
+use polygram_core::layout::Rect;
+
+/// Субклеток в клетке. Весь расчёт маршрута идёт в субклетках целыми числами.
+pub const U: i32 = 16;
+
+/// Точка в субклетках.
+#[derive(Clone, Copy, Debug, PartialEq, Eq, Hash)]
+pub struct Pt {
+    /// X в субклетках.
+    pub x: i32,
+    /// Y в субклетках.
+    pub y: i32,
+}
+
+impl Pt {
+    /// Создать точку.
+    pub const fn new(x: i32, y: i32) -> Self {
+        Self { x, y }
+    }
+}
+
+/// Сторона карточки, из которой линия выходит или в которую входит.
+/// Порядок обхода важен для детерминизма: Правая раньше Левой.
+#[derive(Clone, Copy, Debug, PartialEq, Eq, Hash)]
+pub enum Side {
+    /// Правая сторона.
+    Right,
+    /// Левая сторона.
+    Left,
+}
+
+impl Side {
+    /// Обе стороны в порядке обхода.
+    pub const BOTH: [Side; 2] = [Side::Right, Side::Left];
+
+    /// Знак «наружу» от карточки: +1 вправо, −1 влево.
+    pub fn sign(self) -> i32 {
+        match self {
+            Side::Right => 1,
+            Side::Left => -1,
+        }
+    }
+}
+
+/// Качество маршрута. Чем дальше по списку, тем хуже.
+#[derive(Clone, Copy, Debug, PartialEq, Eq, PartialOrd, Ord, Hash)]
+pub enum Quality {
+    /// Охранная зона 1 клетка, заглушка не короче 2 клеток.
+    Clean,
+    /// Охранная зона 0, заглушка не короче 2 клеток.
+    Tight,
+    /// Охранная зона 0, заглушка не короче 1 клетки.
+    Short,
+    /// Запасная ломаная без поиска; может пересекать карточки.
+    Fallback,
+}
+
+/// Конец связи: прямоугольник карточки (клетки), идентификатор и два порта (субклетки).
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub struct Terminal {
+    /// Идентификатор карточки (по нему определяется «своя» карточка).
+    pub card: u32,
+    /// Прямоугольник карточки в клетках.
+    pub rect: Rect,
+    /// Левый порт строки (субклетки).
+    pub left: Pt,
+    /// Правый порт строки (субклетки).
+    pub right: Pt,
+}
+
+impl Terminal {
+    /// Порт нужной стороны.
+    pub fn port(&self, side: Side) -> Pt {
+        match side {
+            Side::Right => self.right,
+            Side::Left => self.left,
+        }
+    }
+
+    /// Вертикаль карточки на нужной стороне (клетки).
+    pub fn edge_x(&self, side: Side) -> i32 {
+        match side {
+            Side::Right => self.rect.x + self.rect.w,
+            Side::Left => self.rect.x,
+        }
+    }
+}
+
+/// Готовый маршрут.
+#[derive(Clone, Debug, PartialEq, Eq)]
+pub struct Route {
+    /// Сторона источника.
+    pub src_side: Side,
+    /// Сторона цели.
+    pub dst_side: Side,
+    /// Точки в субклетках: первая — порт источника, последняя — порт цели.
+    pub points: Vec<Pt>,
+    /// Качество.
+    pub quality: Quality,
+    /// Область влияния (клетки): изменения карточек вне неё маршрут не меняют.
+    pub region: Rect,
+}
+
+impl Route {
+    /// Длина ломаной в субклетках.
+    pub fn length(&self) -> i64 {
+        self.points
+            .windows(2)
+            .map(|w| ((w[1].x - w[0].x).abs() + (w[1].y - w[0].y).abs()) as i64)
+            .sum()
+    }
+
+    /// Число колен.
+    pub fn bends(&self) -> usize {
+        self.points.len().saturating_sub(2)
+    }
+}
+
+/// Округление «от нуля» (половины уходят от нуля, в том числе для отрицательных).
+pub fn round_away(v: f32) -> i32 {
+    v.round() as i32
+}
+
+/// Убрать повторы подряд и средние точки из трёх на одной прямой
+/// (включая разворот на 180° по той же прямой).
+pub fn simplify(pts: Vec<Pt>) -> Vec<Pt> {
+    let mut out: Vec<Pt> = Vec::with_capacity(pts.len());
+    for p in pts {
+        if out.last() == Some(&p) {
+            continue;
+        }
+        out.push(p);
+        while out.len() >= 3 {
+            let n = out.len();
+            let (a, b, c) = (out[n - 3], out[n - 2], out[n - 1]);
+            let same_x = a.x == b.x && b.x == c.x;
+            let same_y = a.y == b.y && b.y == c.y;
+            if same_x || same_y {
+                out.remove(n - 2);
+            } else {
+                break;
+            }
+        }
+    }
+    out
+}
+
+/// Рамка клеток, охватывающая два прямоугольника (в клетках).
+pub fn union_rect(a: &Rect, b: &Rect) -> Rect {
+    let x0 = a.x.min(b.x);
+    let y0 = a.y.min(b.y);
+    let x1 = (a.x + a.w).max(b.x + b.w);
+    let y1 = (a.y + a.h).max(b.y + b.h);
+    Rect::new(x0, y0, x1 - x0, y1 - y0)
+}
+
+/// Манхэттенское расстояние между двумя точками (субклетки).
+pub fn manhattan(a: Pt, b: Pt) -> i32 {
+    (a.x - b.x).abs() + (a.y - b.y).abs()
+}
diff -ruN -x target -x Cargo.lock a/crates/canvas/src/routing/obstacles.rs b/crates/canvas/src/routing/obstacles.rs
--- a/crates/canvas/src/routing/obstacles.rs	1970-01-01 00:00:00.000000000 +0000
+++ b/crates/canvas/src/routing/obstacles.rs	2026-11-25 09:15:20.000000000 +0000
@@ -0,0 +1,80 @@
+//! Препятствия и проверки свободы отрезков.
+//! Границы препятствий в клетках, отрезки в субклетках; все неравенства строгие
+//! (касание границы разрешено).
+
+use super::model::{union_rect, Terminal, U};
+use polygram_core::layout::Rect;
+
+/// Дальность влияния (клетки): наибольшее поле окна 120 + предельный вылет заглушки 150.
+pub const REACH: i32 = 270;
+
+/// Чья это карточка относительно маршрута.
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub enum Own {
+    /// Карточка источника.
+    Src,
+    /// Карточка цели.
+    Dst,
+    /// Любая другая.
+    Other,
+}
+
+/// Препятствие: карточка, раздутая на охранную зону (клетки).
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub struct Obstacle {
+    /// Левая граница.
+    pub x0: i32,
+    /// Верхняя граница.
+    pub y0: i32,
+    /// Правая граница.
+    pub x1: i32,
+    /// Нижняя граница.
+    pub y1: i32,
+    /// Метка принадлежности.
+    pub own: Own,
+}
+
+/// Построить препятствия: берутся карточки, строго пересекающие рамку пары, расширенную на
+/// `REACH`; каждая раздувается на `clear` клеток. Метка определяется по идентификатору карточки.
+pub fn build(cards: &[(u32, Rect)], src: &Terminal, dst: &Terminal, clear: i32) -> Vec<Obstacle> {
+    let pair = union_rect(&src.rect, &dst.rect);
+    let frame = Rect::new(pair.x - REACH, pair.y - REACH, pair.w + 2 * REACH, pair.h + 2 * REACH);
+    let mut out = Vec::new();
+    for (id, r) in cards {
+        if !frame.overlaps(r) {
+            continue;
+        }
+        let own = if *id == src.card {
+            Own::Src
+        } else if *id == dst.card {
+            Own::Dst
+        } else {
+            Own::Other
+        };
+        out.push(Obstacle {
+            x0: r.x - clear,
+            y0: r.y - clear,
+            x1: r.x + r.w + clear,
+            y1: r.y + r.h + clear,
+            own,
+        });
+    }
+    out
+}
+
+/// Вертикаль на колонке `x` (клетки) между высотами `ya` и `yb` (субклетки) свободна,
+/// если ни одно препятствие (с любой меткой) не заходит на неё строго.
+pub fn v_free(obs: &[Obstacle], x: i32, ya: i32, yb: i32) -> bool {
+    let (lo, hi) = (ya.min(yb), ya.max(yb));
+    !obs.iter()
+        .any(|o| o.x0 < x && x < o.x1 && o.y0 * U < hi && lo < o.y1 * U)
+}
+
+/// Горизонталь на высоте `y` (субклетки) между `xa` и `xb` (субклетки) свободна,
+/// если её не задевает ни одно препятствие, кроме меток из `skip`.
+pub fn h_free(obs: &[Obstacle], y: i32, xa: i32, xb: i32, skip: &[Own]) -> bool {
+    let (lo, hi) = (xa.min(xb), xa.max(xb));
+    !obs.iter().any(|o| {
+        !skip.contains(&o.own) && o.y0 * U < y && y < o.y1 * U && o.x0 * U < hi && lo < o.x1 * U
+    })
+}
diff -ruN -x target -x Cargo.lock a/crates/canvas/src/routing/ports.rs b/crates/canvas/src/routing/ports.rs
--- a/crates/canvas/src/routing/ports.rs	1970-01-01 00:00:00.000000000 +0000
+++ b/crates/canvas/src/routing/ports.rs	2026-11-25 09:16:53.000000000 +0000
@@ -0,0 +1,57 @@
+//! Геометрия строк Процесса и точки сцепления.
+//!
+//! Все размеры берутся из тех же констант, что и отрисовка карточки (`paint::constants`), и
+//! считаются в пикселях при масштабе 1. Порт стоит на внешнем краю строки показателя, на высоте
+//! её центра: левый порт — на левом краю строки, правый — на правом.
+
+use polygram_core::types::Direction;
+
+use super::model::Side;
+use crate::paint::constants::{
+    CONTAINER_HEADER_H_PX, CONTAINER_PADDING_PX, GAP_PX, PROCESS_CARD_W_PX, PROCESS_HEADER_H_PX,
+    PROCESS_PADDING_PX, ROW_H_PX,
+};
+
+/// Высота контейнера: шапка + строки + промежутки + отступы. Пустой контейнер содержит
+/// строку «+ Добавить показатель».
+fn container_height_px(n: usize) -> f32 {
+    let (p, h, r, g) = (CONTAINER_PADDING_PX, CONTAINER_HEADER_H_PX, ROW_H_PX, GAP_PX);
+    if n == 0 {
+        p + h + r + p
+    } else {
+        p + h + n as f32 * r + (n - 1) as f32 * g + p
+    }
+}
+
+/// Размер карточки Процесса в пикселях при масштабе 1: (ширина, высота).
+pub fn card_size_px(n_req: usize, n_res: usize) -> (f32, f32) {
+    let h = PROCESS_PADDING_PX
+        + PROCESS_HEADER_H_PX
+        + GAP_PX
+        + container_height_px(n_req)
+        + GAP_PX
+        + container_height_px(n_res)
+        + PROCESS_PADDING_PX;
+    (PROCESS_CARD_W_PX, h)
+}
+
+/// Смещение порта строки от левого верхнего угла карточки (пиксели, масштаб 1).
+/// `n_req` нужен, чтобы найти начало контейнера «Результат».
+pub fn row_port_px(n_req: usize, dir: Direction, row: usize, side: Side) -> (f32, f32) {
+    let inset = PROCESS_PADDING_PX + CONTAINER_PADDING_PX;
+    let x = match side {
+        Side::Left => inset,
+        Side::Right => PROCESS_CARD_W_PX - inset,
+    };
+    let req_top = PROCESS_PADDING_PX + PROCESS_HEADER_H_PX + GAP_PX;
+    let container_top = match dir {
+        Direction::Request => req_top,
+        Direction::Result => req_top + container_height_px(n_req) + GAP_PX,
+    };
+    let y = container_top
+        + CONTAINER_PADDING_PX
+        + CONTAINER_HEADER_H_PX
+        + row as f32 * (ROW_H_PX + GAP_PX)
+        + ROW_H_PX / 2.0;
+    (x, y)
+}
diff -ruN -x target -x Cargo.lock a/crates/canvas/src/routing/router.rs b/crates/canvas/src/routing/router.rs
--- a/crates/canvas/src/routing/router.rs	1970-01-01 00:00:00.000000000 +0000
+++ b/crates/canvas/src/routing/router.rs	2026-11-25 09:16:21.000000000 +0000
@@ -0,0 +1,118 @@
+//! Маршрутизатор: ступени качества, область влияния, запасная ломаная.
+
+use polygram_core::layout::Rect;
+
+use super::direct::{self, Candidate};
+use super::model::{manhattan, simplify, union_rect, Pt, Quality, Route, Side, Terminal, U};
+use super::obstacles;
+use super::search::{search, MARGINS};
+
+/// Ступени качества по порядку: (охранная зона, минимальная заглушка, качество).
+pub const TIERS: [(i32, i32, Quality); 3] = [
+    (1, 2, Quality::Clean),
+    (0, 2, Quality::Tight),
+    (0, 1, Quality::Short),
+];
+
+/// Нижняя граница длины (субклетки): наименьшее манхэттенское расстояние между портами.
+pub fn lower_bound(src: &Terminal, dst: &Terminal) -> i32 {
+    let mut lb = i32::MAX;
+    for s in Side::BOTH {
+        for t in Side::BOTH {
+            lb = lb.min(manhattan(src.port(s), dst.port(t)));
+        }
+    }
+    lb
+}
+
+/// Решение одной ступени качества. `None` — пути нет.
+pub fn solve(
+    obs: &[obstacles::Obstacle],
+    src: &Terminal,
+    dst: &Terminal,
+    min_stub: i32,
+) -> Option<Candidate> {
+    let lb = lower_bound(src, dst) as i64;
+    let direct = direct::best(obs, src, dst, min_stub);
+    if let Some(d) = &direct {
+        if d.len == lb {
+            return direct;
+        }
+    }
+    let mut best = direct;
+    for m in MARGINS {
+        if let Some(c) = search(obs, src, dst, min_stub, m, false) {
+            if best.as_ref().map_or(true, |b| c.cost < b.cost) {
+                best = Some(c);
+            }
+        }
+        if let Some(b) = &best {
+            if b.len <= lb + 2 * m as i64 * U as i64 {
+                break;
+            }
+        }
+    }
+    best
+}
+
+/// Построить маршрут между двумя терминалами среди карточек `cards` (идентификатор, прямоугольник).
+/// Всегда возвращает маршрут: если ни одна ступень не нашла путь, строится запасная ломаная.
+pub fn route(cards: &[(u32, Rect)], src: &Terminal, dst: &Terminal) -> Route {
+    let lb = lower_bound(src, dst) as i64;
+    for (clear, stub, quality) in TIERS {
+        let obs = obstacles::build(cards, src, dst, clear);
+        if let Some(c) = solve(&obs, src, dst, stub) {
+            let slack = if quality == Quality::Clean {
+                ((c.len - lb).max(0) / 2 / U as i64) as i32 + 4
+            } else {
+                300
+            };
+            return Route {
+                src_side: c.src_side,
+                dst_side: c.dst_side,
+                points: c.points,
+                quality,
+                region: region(src, dst, slack),
+            };
+        }
+    }
+    fallback(src, dst)
+}
+
+/// Область влияния: рамка карточек и портов (клетки), расширенная на запас.
+pub fn region(src: &Terminal, dst: &Terminal, slack: i32) -> Rect {
+    let u = union_rect(&src.rect, &dst.rect);
+    let (mut x0, mut y0, mut x1, mut y1) = (u.x, u.y, u.x + u.w, u.y + u.h);
+    for p in [src.left, src.right, dst.left, dst.right] {
+        let (cx, cy) = (p.x.div_euclid(U), p.y.div_euclid(U));
+        x0 = x0.min(cx);
+        y0 = y0.min(cy);
+        x1 = x1.max(cx + 1);
+        y1 = y1.max(cy + 1);
+    }
+    Rect::new(x0 - slack, y0 - slack, (x1 - x0) + 2 * slack, (y1 - y0) + 2 * slack)
+}
+
+/// Запасная ломаная: источник Правая, цель Левая, по колонкам на 2 клетки от карточек.
+/// Ортогональна и существует всегда, но может пересекать карточки.
+pub fn fallback(src: &Terminal, dst: &Terminal) -> Route {
+    let (ps, pt) = (src.port(Side::Right), dst.port(Side::Left));
+    let vs = (src.rect.x + src.rect.w + 2) * U;
+    let vt = (dst.rect.x - 2) * U;
+    let ym = ((ps.y + pt.y) / 2 / U) * U;
+    let points = simplify(vec![
+        ps,
+        Pt::new(vs, ps.y),
+        Pt::new(vs, ym),
+        Pt::new(vt, ym),
+        Pt::new(vt, pt.y),
+        pt,
+    ]);
+    Route {
+        src_side: Side::Right,
+        dst_side: Side::Left,
+        points,
+        quality: Quality::Fallback,
+        region: region(src, dst, 300),
+    }
+}
diff -ruN -x target -x Cargo.lock a/crates/canvas/src/routing/screen.rs b/crates/canvas/src/routing/screen.rs
--- a/crates/canvas/src/routing/screen.rs	1970-01-01 00:00:00.000000000 +0000
+++ b/crates/canvas/src/routing/screen.rs	2026-11-25 09:16:53.000000000 +0000
