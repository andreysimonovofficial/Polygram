{"cmd":"add_metric","node":"smelter","dir":"output","id":"o1","name":"Металл","unit":"т/ч","value":80}
{"cmd":"add_node","id":"factory","name":"Завод"}
{"cmd":"add_metric","node":"factory","dir":"input","id":"i1","name":"Металл","unit":"т/ч","required":60}
{"cmd":"add_metric","node":"factory","dir":"input","id":"i2","name":"Энергия","unit":"МВт","required":50}
